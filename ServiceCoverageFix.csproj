<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <CSII_TOOLPATH Condition="'$(CSII_TOOLPATH)' == '' and '$(OS)' == 'Windows_NT'">$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))</CSII_TOOLPATH>
    <Configurations>Debug;Release</Configurations>
    <DefineConstants>$(DefineConstants);SCF_BETA</DefineConstants>
    <AssemblyName>ServiceCoverageFix</AssemblyName>
    <RootNamespace>ServiceCoverageFix</RootNamespace>
    <Version>0.4.3</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Ensure third-party runtime assemblies are placed beside the mod DLL. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Required by the official Cities: Skylines II mod template. -->
    <PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- An in-place source upgrade may leave these 0.4.1 workers on disk. -->
    <Compile Include="src/**/*.cs" Exclude="src/Beta/HousingJob.cs;src/Beta/SellerJob.cs" />
  </ItemGroup>

  <!-- Imports must remain after the first PropertyGroup. -->
  <Import Project="$(CSII_TOOLPATH)\Mod.props" />
  <Import Project="$(CSII_TOOLPATH)\Mod.targets" />
  <Import Project="tools/WorkerGenerator.targets" />

  <ItemGroup>
    <!-- Runtime-private dependency. The mod no longer depends on the stale
         CS2 DependencyPack subscription. -->
    <PackageReference Include="Lib.Harmony" Version="2.2.2"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Unity.Entities"><Private>false</Private></Reference>
    <Reference Include="Colossal.Collections"><Private>false</Private></Reference>
    <Reference Include="Colossal.Mathematics"><Private>false</Private></Reference>
    <Reference Include="Game"><Private>false</Private></Reference>
    <Reference Include="Colossal.Mono.Cecil"><Private>false</Private></Reference>
    <Reference Include="Colossal.Core"><Private>false</Private></Reference>
    <Reference Include="Colossal.Logging"><Private>false</Private></Reference>
    <Reference Include="Colossal.IO.AssetDatabase"><Private>false</Private></Reference>
    <Reference Include="Colossal.UI"><Private>false</Private></Reference>
    <Reference Include="Colossal.UI.Binding"><Private>false</Private></Reference>
    <Reference Include="Colossal.Localization"><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><Private>false</Private></Reference>
    <Reference Include="Unity.Burst"><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System"><Private>false</Private></Reference>
    <Reference Update="System.Core"><Private>false</Private></Reference>
    <Reference Update="System.Data"><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
    <None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
    <None Update="THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="VerifyHarmonyRuntimeWasCopied" AfterTargets="Build">
    <Error Condition="!Exists('$(TargetDir)0Harmony.dll')"
           Text="The required private 0Harmony.dll runtime was not copied to the mod output." />
  </Target>

</Project>

