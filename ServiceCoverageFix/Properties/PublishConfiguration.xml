<Publish>
	<!--Id must be set in order to update existed mod. it is not required for publishing mod for the first time-->
	<ModId Value="" />
	<!--Name of the mod to display to players-->
	<DisplayName Value="ServiceCoverageFix" />
	<!--Short description of the mod-->
	<ShortDescription Value="Removes the deterministic service-coverage merge stutter without changing coverage results." />
	<!--Long description of the mod. Single line or multi line. Supports minimal markdown subset-->
	<LongDescription>
Replaces a pathological linear-reinsertion merge in ServiceCoverageSystem with an equivalent monotone radix-queue merge and a binary-heap safety fallback. This build is locked to the analyzed Game.dll and fails closed on incompatible game versions.
	</LongDescription>
	<!--Thumbnail-->
	<Thumbnail Value="Properties/Thumbnail.png" />
	<!--Screenshot, can be set multiple times-->
