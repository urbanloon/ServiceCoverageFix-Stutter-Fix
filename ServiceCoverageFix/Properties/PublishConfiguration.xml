	<!--Version of the mod-->
	<ModVersion Value="0.1.4" />
	<!--Recommended version of the base game to use the mod-->
	<GameVersion Value="*" />
	<!--No external mod dependency. Harmony is packaged privately with this mod.-->
	<!--No DLC is required.-->
	<!--Change log for new version. Single line or multi line. Supports minimal markdown subset-->
	<ChangeLog Value="Replaced the remaining O(E log B) heap bottleneck with an exact monotone radix queue after post-fix ETW validation." />
