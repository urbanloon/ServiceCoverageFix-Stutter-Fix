+        // The radix queue has already resolved this exact value when it pops
+        // the runner. Zero encodings compare equally in the active float mode.
+        private static float CoverageFromPriority(uint priority)
+        {
+            uint mask = (uint)(~(int)priority >> 31) & 0x7FFFFFFFu;
+            return math.asfloat(priority ^ mask);
+        }
+
+        private const int NearBits = 10;
+        private const int NearSize = 1 << NearBits;
+        private const int NearShift = 0;
+
+        private struct Calendar
+        {
+            public int* Near;
+            public ulong* Occupancy;
+            public int* Far;
+            public uint* MinWindows;
+            public uint WordMask, FarMask, Window;
+        }
+
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        private static void CalendarAdd(ProviderSlot* slots, ref Calendar q, int id, uint priority)
+        {
+            uint window = priority >> (NearBits + NearShift);
+            if (window != q.Window)
+            {
+                int group = 31 - math.lzcnt(window ^ q.Window);
+                slots[id].Node.Next = q.Far[group];
+                if (q.Far[group] == -1)
+                {
+                    q.MinWindows[group] = window;
+                    q.FarMask |= 1u << group;
+                }
+                else
+                    q.MinWindows[group] = math.min(q.MinWindows[group], window);
+                q.Far[group] = id;
+                return;
+            }
+            int index = (int)(priority >> NearShift) & (NearSize - 1);
+            int head = q.Near[index];
+            if (head == -1)
+            {
+                int word = index >> 6;
+                q.WordMask |= 1u << word;
+                q.Occupancy[word] |= 1ul << index;
+            }
+            else if (NearShift != 0 && slots[head].Node.Priority < priority)
+            {
+                int before = head;
+                int next = slots[before].Node.Next;
+                while (next != -1 && slots[next].Node.Priority < priority)
+                {
+                    before = next;
+                    next = slots[before].Node.Next;
+                }
+                slots[id].Node.Next = next;
+                slots[before].Node.Next = id;
+                return;
+            }
+            slots[id].Node.Next = head;
+            q.Near[index] = id;
+        }
+
+        // Called only at window changes. Reverse before prepending to preserve
+        // the original order for equal priorities during redistribution.
+        private static void AdvanceCalendar(ProviderSlot* slots, ref Calendar q)
+        {
+            int source = math.tzcnt(q.FarMask);
+            q.FarMask &= ~(1u << source);
+            q.Window = q.MinWindows[source];
+            int current = q.Far[source];
+            q.Far[source] = -1;
+            int oldest = -1;
+            while (current != -1)
+            {
+                int previous = slots[current].Node.Next;
+                slots[current].Node.Next = oldest;
+                oldest = current;
+                current = previous;
+            }
+            while (oldest != -1)
+            {
+                int newer = slots[oldest].Node.Next;
+                CalendarAdd(slots, ref q, oldest, slots[oldest].Node.Priority);
+                oldest = newer;
+            }
+        }
