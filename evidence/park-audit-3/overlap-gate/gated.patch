+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private static int ExecutePair(ProviderSlot* slots, RawCoverageElement* elements,
+            int* heads, int* tails, uint* minimums, ulong* occupancy, uint occupiedWordMask, uint lastPriority)
+        {
+            int winner = 0;
+            int skipped = 0;
+            int runner = ByteTakeWinner(slots, heads, tails, minimums, occupancy,
+                ref occupiedWordMask, ref lastPriority);
+            float cutoff = elements[slots[runner].State.NextIndex].AverageCoverage;
+            while (true)
+            {
+                // The third provider stays fixed while the front pair alternates.
+                bool hasThird = occupiedWordMask != 0;
+                int third = -1;
+                float floor = 0f;
+                if (hasThird)
+                {
+                    third = ByteTakeWinner(slots, heads, tails, minimums, occupancy,
+                        ref occupiedWordMask, ref lastPriority);
+                    floor = elements[slots[third].State.NextIndex].AverageCoverage;
+                }
+                while (true)
+                {
+                    ProviderState* state = &slots[winner].State;
+                    ProviderState local = *state;
+                    int cursor = local.NextIndex;
+                    int end = local.EndIndex;
+                    bool hasNext;
+                    float next;
+                    do
+                    {
+                        int index = cursor++;
+                        hasNext = cursor != end;
+                        next = hasNext ? elements[cursor].AverageCoverage : 0f;
+                        if (!ApplyElement(&local, elements + index)) hasNext = false;
+                    }
+                    while (hasNext && !(next < cutoff));
+                    state->NextIndex = cursor;
+                    state->Remaining = local.Remaining;
+
+                    if (!hasNext)
+                    {
+                        skipped += end - cursor;
+                        if (!hasThird)
+                            return skipped + ExecuteSingleProvider(&slots[runner].State, elements);
+                    }
+                    else if (!hasThird || !(next < floor))
+                    {
+                        // The old winner lost to the runner but remains ahead
+                        // of the third. Its equality wins the reinsert tie.
+                        int previous = winner;
+                        winner = runner;
+                        runner = previous;
+                        cutoff = next;
+                        continue;
+                    }
+                    else
+                    {
+                        uint priority = GetPriority(next);
+                        BytePrepend(slots, heads, tails, minimums, occupancy,
+                            ref occupiedWordMask, winner, GetByteBucket(priority, lastPriority), priority);
+                    }
+                    winner = runner;
+                    runner = third;
+                    cutoff = floor;
+                    break;
+                }
+            }
+        }
