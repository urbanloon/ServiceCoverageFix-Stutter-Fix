+    static unsafe void TimeClassifier(Inputs input, Pass pass, string shape, string binary)
+    {
+        var sorted = input.Providers.OrderByDescending(p => input.Elements[p.Start].Priority).ToArray();
+        for (int i=0;i<sorted.Length;i++) sorted[i].Count += sorted[i].Start;
+        var symbol = File.ReadAllText(binary+".symbol").Trim();
+        var test = (delegate* unmanaged[Cdecl]<Provider*, nint, int, int, byte>)NativeLibrary.GetExport(NativeLibrary.Load(binary), symbol);
+        nint elementAddress = BlockAddress(pass, "elements");
+        fixed (Provider* records=sorted)
+        {
+            byte decision=test(records, elementAddress, sorted.Length, input.Elements.Length);
+            for(int round=0; round<12; round++)
+            {
+                long before=ThreadNanoseconds();
+                int sum=0;
+                for(int i=0;i<4000;i++) sum+=test(records,elementAddress, sorted.Length,input.Elements.Length);
+                long elapsed=ThreadNanoseconds()-before;
+                if (sum!=4000*decision)throw new Exception("nondeterministic classifier");
+                Console.Error.WriteLine($"MICRO,{shape},{round},{decision},{elapsed/4000.0:F2}");
+            }
+        }
+    }
