+    static Inputs Challenge(int seed, string shape)
+    {
+        if (shape == "small") return Inputs.Make(seed, 12, 96, 0, true);
+        if (shape is "local" or "citywide" or "tight" or "mixed" or "ties") return Make(seed, shape);
+        var data = Inputs.Make(seed, Providers, VisitsPerProvider, 0, true);
+        int total = data.Elements.Length;
+        var rng = new Random(seed ^ 79);
+        for (int p = 0; p < Providers; p++)
+        {
+            float budget = shape == "falsehot" ? 100f : 746.25f;
+            data.Providers[p].Total = data.Providers[p].Remaining = budget;
+            for (int r = 0; r < VisitsPerProvider; r++)
+            {
+                int i = p * VisitsPerProvider + r;
+                ref var el = ref data.Elements[i];
+                el.X = el.Y = el.Priority = 0.5f + 0.5f * el.Priority;
+                el.Density = el.Length = 1f;
+                int unique = (int)(((long)i * 15485863 + 3121) % total);
+                int road = shape switch {
+                    "hubs" when r % 5 == 0 => (r/5+17*p) % 449,
+                    "hubs" => 449 + unique,
+                    "bait" when r < 24 => r,
+                    "bait" => 24 + unique,
+                    "falsehot" when r < 240 => RoadCount + unique,
+                    "falsehot" => (p * 813 + r * 17) % RoadCount,
+                    "deep" when r < 1000 => RoadCount + unique,
+                    "deep" => (p * 813 + r * 17) % RoadCount,
+                    "sparse" => (p * 1597 + r * 857) % 250003,
+                    "sharedinter" => (p * 813 + r * 17) % RoadCount,
+                    "disjoint" => unique,
+                    _ => throw new ArgumentException(shape)
+                };
+                el.Target = road;
+            }
+        }
+        return new Inputs(data.Providers, data.Elements, new float[2 * (total + RoadCount)]);
+    }
+    static unsafe void Observe(Inputs input, nint targetBase, string shape)
+    {
+        var sorted = input.Providers.OrderByDescending(p => input.Elements[p.Start].Priority).ToArray();
+        if (sorted.Length < 384) return;
+        var all = new HashSet<nint>();
+        foreach (var el in input.Elements) all.Add(el.Target);
+        for (int band=0; band<2; band++)
+        {
+            var exact = new HashSet<nint>();
+            var duplicates = new HashSet<nint>();
+            var direct = new ulong[256];
+            var detected = new HashSet<ulong>();
+            int step=sorted.Length/384;
+            for (int k=0; k<384; k++)
+            {
+                var p=sorted[k*step];
+                int relative=(p.Count>>3)*(1 + 4 * band) + ((k*53)&63) % Math.Max(1,p.Count>>3);
+                ulong a=(ulong)(targetBase+8*input.Elements[p.Start+relative].Target);
+                if (!exact.Add((nint)a)) duplicates.Add((nint)a);
+                int bin=(int)(((a>>3)*11400714819323198485UL)>>56);
+                if (direct[bin]==a) detected.Add(a);
+                direct[bin]=a;
+            }
+            Console.Error.WriteLine($"PROBE,{shape},{band},{input.Elements.Length},{all.Count},{384-exact.Count},{duplicates.Count},{detected.Count}");
+        }
+    }
