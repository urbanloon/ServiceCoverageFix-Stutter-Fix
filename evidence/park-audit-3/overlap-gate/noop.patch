+        // Sample separate portions of different providers and require two distinct
+        // repeated road addresses in each portion. No target is dereferenced.
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private static bool HasSharedTargets(ProviderSlot* slots, RawCoverageElement* elements,
+            int providers, int elementLength)
+        {
+            const int samples = 384;
+            if (providers < samples || elementLength < 262144) return false;
+            ulong* seen = stackalloc ulong[256];
+            int stride = providers / samples;
+            for (int band = 0; band < 2; band++)
+            {
+                for (int j = 0; j < 256; j++) seen[j] = 0;
+                ulong firstDuplicate = 0;
+                bool confirmed = false;
+                for (int j = 0; j < samples; j++)
+                {
+                    ProviderState state = slots[j * stride].State;
+                    if (state.NextIndex < 0 || state.EndIndex > elementLength ||
+                        state.EndIndex < state.NextIndex || state.EndIndex - state.NextIndex < 512)
+                        return false;
+                    int eighth = (state.EndIndex - state.NextIndex) >> 3;
+                    int index = state.NextIndex + eighth * (1 + 4 * band) + ((j * 53) & 63);
+                    ulong address = (ulong)elements[index].CoveragePtr;
+                    if (address == 0) return false;
+                    int bin = (int)(unchecked((address >> 3) * 11400714819323198485UL) >> 56);
+                    if (seen[bin] == address)
+                    {
+                        if (firstDuplicate != 0 && firstDuplicate != address)
+                        {
+                            confirmed = true;
+                            break;
+                        }
+                        firstDuplicate = address;
+                    }
+                    seen[bin] = address;
+                }
+                if (!confirmed) return false;
+            }
+            return true;
+        }
