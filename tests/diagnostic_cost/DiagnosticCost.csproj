<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SourceRoot Condition="'$(SourceRoot)' == ''">../../src</SourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceRoot)/*.cs" />
    <Compile Include="../runtime_harness/Stubs.cs" />
    <Reference Include="Colossal.Mono.Cecil" HintPath="$(GameManagedPath)/Colossal.Mono.Cecil.dll" />
    <Reference Include="Unity.Mathematics" HintPath="$(GameManagedPath)/Unity.Mathematics.dll" />
  </ItemGroup>
</Project>
